+# ---------------------------------------------------------------------------------------------
+# 2026-09-27 (final-day sprint, design A): `ffvit` -- ONE network holding the two shipped families
+# as two STREAMS that exchange features. See final0927/notes/design_a.md.
+FFVIT_ARCHS = ("ffvit", "ffvit0")
+
+
+class FFViT2d(nn.Module):
+    """Cross-stitched F-FNO x ViT.
+
+    Stream `f` is an FFNO2d (per-pixel, separable spectral mixing), stream `v` a ViT2d (128 tokens,
+    input-dependent global attention). Both read the same input and run layer for layer in lockstep.
+    After the layers in LINKS the streams trade features:
+        f2v[i]: LayerNorm2d(w) -> Conv(w, 384, 4, stride 4) -> GELU -> Conv1x1(384, 384)   added to t
+        v2f[i]: LayerNorm(384) -> Linear(384, 384) -> GELU -> Linear(384, w*16), unpatchify added to h
+    The LAST layer of every link is ZERO-initialised, so with `f.*` / `v.*` loaded from a trained
+    F-FNO and a trained ViT the network at step 0 is exactly the two parents run side by side.
+    Output: field = s*field_f + (1-s)*field_v with s = sigmoid(mix) (learned scalar, init WF), and
+    sigma = s*sigma_f + (1-s)*sigma_v (returned as its log) -- i.e. at step 0 the WF-weighted
+    ensemble of the two parents, the same field/sigma averaging `_fno.fuse` groups perform.
+
+    `links=False` (`ffvit0`) builds no link at all: the paired control, which fine-tunes the same two
+    parents through the same mixed output, so arm minus control is the cross-stitch and nothing else.
+
+    State-dict names are `f.<FFNO2d name>` and `v.<ViT2d name>`: `make_ffvit_init.py` writes a
+    merged parent file with exactly those keys for `train2.py --init`.
+    """
+
+    VIT_DIM, VIT_HEADS = 384, 6
+    LINKS = (1, 3, 5)
+    WF = 1.0 / 3.0
+
+    def __init__(self, width: int = 40, modes_y: int = 16, modes_x: int = 32, n_layers: int = 8,
+                 var_head: bool = True, extra_ch: int = 0, dropout: float = 0.0,
+                 links: bool = True):
+        super().__init__()
+        self.f = FFNO2d(width, modes_y, modes_x, n_layers, var_head, extra_ch, dropout)
+        self.v = ViT2d(self.VIT_DIM, n_layers, var_head, extra_ch, heads=self.VIT_HEADS,
+                       dropout=dropout)
+        self.width = width
+        self.mix = nn.Parameter(torch.tensor(float(np.log(self.WF / (1.0 - self.WF)))))
+        d, pp = self.VIT_DIM, self.v.patch
+        self.f2v, self.v2f = nn.ModuleDict(), nn.ModuleDict()
+        for i in (self.LINKS if links else ()):
+            if i >= n_layers - 1:
+                continue
+            a = nn.Sequential(_LayerNorm2d(width), nn.Conv2d(width, d, pp, stride=pp), nn.GELU(),
+                              nn.Conv2d(d, d, 1))
+            b = nn.Sequential(nn.LayerNorm(d), nn.Linear(d, d), nn.GELU(),
+                              nn.Linear(d, width * pp * pp))
+            for last in (a[-1], b[-1]):
+                nn.init.zeros_(last.weight)
+                nn.init.zeros_(last.bias)
+            self.f2v[str(i)], self.v2f[str(i)] = a, b
+
+    def set_spectral_path(self, path: str = "fft"):
+        self.f.set_spectral_path(path)
+        return self
+
+    def forward(self, prev: torch.Tensor, detach_var: bool = False):
+        f, v = self.f, self.v
+        b, pp, wd = len(prev), v.patch, self.width
+        x = f.cat(prev)
+        h = F.pad(f.lift(x), (0, f.PAD[1], 0, f.PAD[0]))
+        t = v.embed(x).flatten(2).transpose(1, 2) + v.pos
+        for i, (layer, blk, p) in enumerate(zip(f.layers, v.blocks, v.dp)):
+            h = layer(h)
+            q = blk["n1"](t)
+            t = t + v._drop_path(blk["attn"](q, q, q, need_weights=False)[0], p)
+            t = t + v._drop_path(blk["mlp"](blk["n2"](t)), p)
+            k = str(i)
+            if k in self.f2v:
+                dt = self.f2v[k](h[..., :H, :W]).flatten(2).transpose(1, 2)
+                dh = (self.v2f[k](t).reshape(b, v.gh, v.gw, wd, pp, pp)
+                      .permute(0, 3, 1, 4, 2, 5).reshape(b, wd, H, W))
+                t = t + dt
+                h = h + F.pad(dh, (0, f.PAD[1], 0, f.PAD[0]))
+        hf = f.norm_out(h[..., :H, :W])
+        tv = v.proj(v.norm_out(t))
+        hv = (tv.reshape(b, v.gh, v.gw, v.wid, pp, pp)
+              .permute(0, 3, 1, 4, 2, 5).reshape(b, v.wid, H, W))
+        s = torch.sigmoid(self.mix)
+        field = s * f.head_field(hf) + (1.0 - s) * v.head_field(hv)
+        logstd = None
+        if f.head_logstd is not None:
+            lf = f.head_logstd(hf.detach() if detach_var else hf).float()
+            lv = v.head_logstd(hv.detach() if detach_var else hv).float()
+            logstd = torch.logaddexp(lf + F.logsigmoid(self.mix), lv + F.logsigmoid(-self.mix))
+        return field, logstd
+
+
+
+
