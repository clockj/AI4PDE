+"""E0a latency v2: shipped band (A) vs SIGBLEND (B) fast path vs B general path (fast path disabled by monkeypatch), one
+process, interleaved, package batch forced equal for all arms.  Both packages carry the SAME _fno.py (with the fast path).
+usage: k0a_lat2.py <pkgA> <pkgB> <batch> [reps]"""
+import importlib.util, os, sys, time
+import numpy as np, torch
+a, b, bs = sys.argv[1], sys.argv[2], int(sys.argv[3]); reps = int(sys.argv[4]) if len(sys.argv) > 4 else 20
+X = np.load("/users/PAS1187/qwu/workspace/realpde/main/Track_1/val_unseen.npz")["x"]
+def load(pkg, name):
+    spec = importlib.util.spec_from_file_location(name, os.path.join(pkg, "submission.py"))
+    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m
+A, B = load(a, "subA"), load(b, "subB")
+for m in (A, B):
+    m._state = tuple(m._state[:5]) + (bs,) + tuple(m._state[6:])
+fno = B._fno; fast_fn = fno._eband_logsig_only
+def arm(k):
+    if k == "ship": return lambda n: A.predict(X[:n])
+    def f(n):
+        fno._eband_logsig_only = fast_fn if k == "fast" else (lambda _b: False)
+        try: return B.predict(X[:n])
+        finally: fno._eband_logsig_only = fast_fn
+    return f
+arms = {k: arm(k) for k in ("ship", "fast", "general")}
+o1, o2 = arms["fast"](56), arms["general"](56)
+print(f"batch {bs}: fast vs general N=56 lower max|d| {np.abs(o1['lower']-o2['lower']).max():.3e} upper {np.abs(o1['upper']-o2['upper']).max():.3e}", flush=True)
+for n in (14, 56, 99):
+    for k in arms: arms[k](n)
+    T = {k: [] for k in arms}
+    for r in range(reps):
+        order = list(arms) if r % 2 == 0 else list(arms)[::-1]
+        for k in order:
+            torch.cuda.synchronize(); t0 = time.perf_counter(); arms[k](n); torch.cuda.synchronize()
+            T[k].append((time.perf_counter() - t0) * 1e3 / n)
+    T = {k: np.array(v) for k, v in T.items()}
+    s = "  ".join(f"{k} {np.median(v):.4f}" for k, v in T.items())
+    dg, df = T["general"] - T["ship"], T["fast"] - T["ship"]
+    print(f"PACKAGE batch {bs} N={n:<3d} ms/window median: {s} | paired vs ship: general {np.median(dg):+.4f} ({int((dg>0).sum())}/{reps} slower)"
+          f"  fast {np.median(df):+.4f} ({int((df>0).sum())}/{reps} slower)", flush=True)
